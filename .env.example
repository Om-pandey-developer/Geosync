# GeoSync Environment Configuration Example
# Copy this to .env (for local dev) or .env.production (for production deployment)

# Deployment environment ('development' | 'production')
GEOSYNC_ENV=development

# Database Settings (PostgreSQL + PostGIS 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=geosync_db
# For Docker network use 'geosync-db', for localhost use 'localhost'
DATABASE_URL=postgresql://postgres:change_this_to_a_strong_password@geosync-db:5432/geosync_db

# Redis Cache Settings
REDIS_PASSWORD=change_this_to_a_strong_redis_password
REDIS_URL=redis://:change_this_to_a_strong_redis_password@redis:6379/0

# Backend Security & CORS
# Comma-separated list of allowed frontend origins (e.g., https://geosync.yourdomain.com)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend API Endpoint
# In production, set this to your backend public URL or leave blank if using a reverse proxy with /api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
